# Follow instructions from https://api.snooker.org/
SNOOKER_API_HEADER=

# BGA spider (bga_spider.py)
DOWNLOAD_DELAY=10
RESULTS_DIR=results
JOBDIR=.jobs
CONCURRENT_REQUESTS_PER_DOMAIN=16
FEED_EXPORT_BATCH_ITEM_COUNT=100000
SCRAPE_RANKINGS=false
SCRAPE_MATCHES=true
PRIORITISE_POPULAR_GAMES=true
MAX_MATCHES_PER_PAGE=5000
# Optional; cap ranks scraped per game (e.g. 1000)
# MAX_RANK_SCRAPED=

# Game selection: scrape only these games (comma-separated IDs, e.g. 12345,67890)
# ALLOW_LIST_IDS=
# Scrape these games first, others still scraped; boost is added to their priority (each page costs 1)
# PRIORITY_GAME_IDS=
# PRIORITY_GAME_BOOST=10000

# Match start time: start pagination here instead of at the newest match, either
# one Unix timestamp / ISO date for all games (e.g. 2024-05-01)
# or game_id:time pairs (e.g. 1467:2024-05-01,10:1700000000)
# MATCHES_START_TIME=
# Games without explicit start begin at a random time within the last N days
# MATCHES_RANDOM_START_DAYS=
# Scrape status (path or URL, e.g. csv/scrape_status.json): continue each game from its
# newest and oldest scraped match and fill gaps; explicit start times take precedence
# SCRAPE_STATUS=
# With a start time or scrape status: also scrape from the newest match down to it
# SCRAPE_HEAD_MATCHES=true

# Snooker spider (snooker_spider.py)
SNOOKER_START_SEASON=1974
# Optional; defaults to current year
# SNOOKER_END_SEASON=
SNOOKER_TOURS=challenge,ebsa,ibsf,main,other,q,seniors,women,wsf
