SNOOKER_API_HEADER= # Follow instructions from https://api.snooker.org/

# BGA spider (bga_spider.py)
DOWNLOAD_DELAY=10
RESULTS_DIR=results
JOBDIR=.jobs
CONCURRENT_REQUESTS_PER_DOMAIN=16
FEED_EXPORT_BATCH_ITEM_COUNT=100000
SCRAPE_RANKINGS=false
SCRAPE_MATCHES=true
PRIORITISE_POPULAR_GAMES=true
MAX_MATCHES_PER_PAGE=5000
# MAX_RANK_SCRAPED=          # optional; cap ranks scraped per game (e.g. 1000)
# ALLOW_LIST_IDS=           # optional; comma-separated game IDs to scrape only (e.g. 12345,67890)
# PRIORITY_GAME_IDS=        # optional; comma-separated game IDs to scrape first, others still scraped
# PRIORITY_GAME_BOOST=10000 # priority added to those games (each page costs 1)
# MATCHES_START_TIME=       # optional; start match pagination here instead of at the newest match:
#                           #   one Unix timestamp / ISO date for all games (e.g. 2024-05-01)
#                           #   or game_id:time pairs (e.g. 1467:2024-05-01,10:1700000000)
# SCRAPE_HEAD_MATCHES=true  # with a start time: also scrape from the newest match down to it

# Snooker spider (snooker_spider.py)
SNOOKER_START_SEASON=1974
# SNOOKER_END_SEASON=       # optional; defaults to current year
SNOOKER_TOURS=challenge,ebsa,ibsf,main,other,q,seniors,women,wsf
